# Optional provider label; MVP defaults to deterministic local mode.
LLM_PROVIDER=mock/local
OPSPILOT_API_URL=http://localhost:8000
# API security. Development allows local access; production requires keys.
APP_ENV=development
# Example: [{"token":"replace-with-secret","tenant_id":"team-a","role":"admin"}]
TRUSTMESH_API_KEYS=[]
OPSPILOT_API_TOKEN=
TRUSTMESH_PUBLIC_MODE=false
TRUSTMESH_DEMO_PASSWORD=
CORS_ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
RATE_LIMIT_PER_MINUTE=120
MAX_UPLOAD_BYTES=10485760
MAX_UPLOAD_MB=10
# SQLite state is durable; keep its parent directory on a persistent volume.
DATABASE_PATH=data/trustmesh.sqlite3
DATA_ENCRYPTION_KEY=
RETENTION_DAYS=0
EVALUATION_DATASET=data/evaluation_cases.json
# Semantic retrieval is opt-in. Cached model weights are used offline by default.
RETRIEVAL_MODE=auto
MODEL_DOWNLOADS_ALLOWED=false
VECTOR_INDEX_DIR=data/vector-index
RERANKER_ENABLED=false
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
BANDIT_ROUTING_ENABLED=false
LANGGRAPH_ENABLED=true
CLAIM_NLI_ENABLED=false
CLAIM_NLI_MODEL=cross-encoder/nli-deberta-v3-base
CLAIM_NLI_THRESHOLD=0.72
# Optional local model only; defaults stay mock/local and have no network calls.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_SECONDS=120
# disabled by default; set to langfuse or langsmith only with approved credentials.
TRACING_PROVIDER=disabled
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=trustmesh
